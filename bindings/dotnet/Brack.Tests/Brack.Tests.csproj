<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console program, not a test framework project: it needs nothing from NuGet, and ctest runs
       it like the other tests, with brack.dll and the test synth as arguments. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brack\Brack.csproj" />
  </ItemGroup>

</Project>
